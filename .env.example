# Copy this file to .env and fill in the values. Never commit .env.

# --- LLM (Groq) ---
GROQ_API_KEY=
# Pick a current model from https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0

# --- Email (owned Gmail test inbox, app password) ---
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# --- Storage ---
DB_PATH=data/flatmate.db
EXPORT_DIR=exports

# --- Policy (enforced in code, never by the LLM) ---
CURRENCY=Rs
AUTO_RECORD_LIMIT=5000
REMINDER_MIN_DAYS=3
REMINDER_MAX_PER_DEBT=3

# --- Evaluation ---
# Set to false for the memory on/off comparison runs
MEMORY_ENABLED=true

# --- Demo members with real addresses (optional) ---
# A second email account you own. Bilal (flatA) uses it so a real email can be read over IMAP.
# Leave empty to use a plus-address of EMAIL_ADDRESS instead.
BILAL_EMAIL=
